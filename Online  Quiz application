/* ================================
   APPLICATION STATE
================================ */

let username = "";
let currentCategory = "HTML";
let currentQuestion = 0;
let userAnswers = [];
let timeRemaining = 300;
let timerInterval = null;
let latestResult = null;

let history = [];

const categories = [
    {
        name: "HTML",
        icon: "🌐",
        description: "Learn HTML tags, forms, tables, and web page structure."
    },
    {
        name: "CSS",
        icon: "🎨",
        description: "Test your knowledge of styles, layouts, and responsive design."
    },
    {
        name: "JavaScript",
        icon: "⚡",
        description: "Practice variables, functions, arrays, and DOM manipulation."
    },
    {
        name: "Java",
        icon: "☕",
        description: "Explore classes, objects, inheritance, and programming basics."
    },
    {
        name: "Python",
        icon: "🐍",
        description: "Practice Python syntax, data types, functions, and conditions."
    }
];

/* ================================
   LOGIN
================================ */

const loginForm = document.getElementById("loginForm");

loginForm.addEventListener("submit", function(event) {
    event.preventDefault();

    username = document.getElementById("username").value.trim();

    const password = document.getElementById("password").value;

    if (!username || !password) {
        alert("Please enter your username and password.");
        return;
    }

    document.getElementById("loginPage").classList.add("hidden");
    document.getElementById("app").classList.remove("hidden");

    document.getElementById("welcomeTitle").textContent =
        "Welcome, " + username + "!";

    document.getElementById("headerUsername").textContent = username;
    document.getElementById("profileName").value = username;

    showPage("dashboard");
    renderCategories();
    updateDashboard();
});

/* ================================
   NAVIGATION
================================ */

function showPage(pageName) {
    const pages = [
        "dashboard",
        "categories",
        "quiz",
        "results",
        "history",
        "profile"
    ];

    pages.forEach(function(page) {
        document.getElementById(page + "Page")
            .classList.toggle("hidden", page !== pageName);
    });

    document.querySelectorAll(".sidebar button[data-page]")
        .forEach(function(button) {
            button.classList.toggle(
                "active",
                button.dataset.page === pageName
            );
        });

    if (pageName === "dashboard") {
        updateDashboard();
    }

    if (pageName === "history") {
        renderHistory();
    }
}

document.querySelectorAll("[data-page]").forEach(function(button) {
    button.addEventListener("click", function() {
        if (button.dataset.page) {
            showPage(button.dataset.page);
        }
    });
});

document.getElementById("logoutBtn").addEventListener("click", function() {
    stopTimer();

    document.getElementById("app").classList.add("hidden");
    document.getElementById("loginPage").classList.remove("hidden");

    document.getElementById("password").value = "";
});

/* ================================
   CATEGORY DISPLAY
================================ */

function renderCategories() {
    const container = document.getElementById("categoryGrid");

    container.innerHTML = "";

    categories.forEach(function(category) {
        const card = document.createElement("div");

        card.className = "category-card";

        const icon = document.createElement("div");
        icon.className = "category-icon";
        icon.textContent = category.icon;

        const heading = document.createElement("h3");
        heading.textContent = category.name;

        const description = document.createElement("p");
        description.textContent = category.description;

        const count = document.createElement("p");
        count.textContent =
            quizData[category.name].length + " questions";

        const startButton = document.createElement("button");
        startButton.className = "primary-btn";
        startButton.textContent = "Start Quiz";

        startButton.addEventListener("click", function() {
            startQuiz(category.name);
        });

        card.append(icon, heading, description, count, startButton);
        container.appendChild(card);
    });
}

/* ================================
   START QUIZ
================================ */

function startQuiz(category) {
    stopTimer();

    currentCategory = category;
    currentQuestion = 0;
    userAnswers = new Array(quizData[category].length).fill(null);
    timeRemaining = 300;
    latestResult = null;

    document.getElementById("quizTitle").textContent =
        category + " Quiz";

    showPage("quiz");
    renderQuestion();
    updateTimerDisplay();

    timerInterval = setInterval(function() {
        timeRemaining--;
        updateTimerDisplay();

        if (timeRemaining <= 0) {
            stopTimer();
            submitQuiz();
        }
    }, 1000);
}

/* ================================
   DISPLAY QUESTION
================================ */

function renderQuestion() {
    const questions = quizData[currentCategory];
    const question = questions[currentQuestion];

    document.getElementById("questionNumber").textContent =
        "Question " + (currentQuestion + 1) +
        " of " + questions.length;

    document.getElementById("questionText").textContent =
        question.question;

    document.getElementById("quizProgress").style.width =
        ((currentQuestion + 1) / questions.length * 100) + "%";

    const container = document.getElementById("optionsContainer");
    container.innerHTML = "";

    question.options.forEach(function(option, index) {
        const button = document.createElement("button");

        button.className = "option";
        button.textContent =
            String.fromCharCode(65 + index) + ". " + option;

        if (userAnswers[currentQuestion] === index) {
            button.classList.add("selected");
        }

        button.addEventListener("click", function() {
            userAnswers[currentQuestion] = index;
            renderQuestion();
        });

        container.appendChild(button);
    });

    document.getElementById("previousBtn").disabled =
        currentQuestion === 0;

    document.getElementById("previousBtn").style.opacity =
        currentQuestion === 0 ? "0.5" : "1";

    const isLastQuestion = currentQuestion === questions.length - 1;

    document.getElementById("nextBtn")
        .classList.toggle("hidden", isLastQuestion);

    document.getElementById("submitBtn")
        .classList.toggle("hidden", !isLastQuestion);
}

/* ================================
   QUESTION NAVIGATION
================================ */

document.getElementById("nextBtn").addEventListener("click", function() {
    if (currentQuestion < quizData[currentCategory].length - 1) {
        currentQuestion++;
        renderQuestion();
    }
});

document.getElementById("previousBtn").addEventListener("click", function() {
    if (currentQuestion > 0) {
        currentQuestion--;
        renderQuestion();
    }
});

document.getElementById("submitBtn").addEventListener("click", function() {
    const unanswered = userAnswers.filter(function(answer) {
        return answer === null;
    }).length;

    if (unanswered > 0) {
        const confirmSubmit = confirm(
            "You have " + unanswered +
            " unanswered questions. Submit anyway?"
        );

        if (!confirmSubmit) {
            return;
        }
    }

    submitQuiz();
});

/* ================================
   TIMER
================================ */

function updateTimerDisplay() {
    const minutes = Math.floor(timeRemaining / 60);
    const seconds = timeRemaining % 60;

    document.getElementById("timer").textContent =
        String(minutes).padStart(2, "0") + ":" +
        String(seconds).padStart(2, "0");
}

function stopTimer() {
    if (timerInterval !== null) {
        clearInterval(timerInterval);
        timerInterval = null;
    }
}

/* ================================
   SUBMIT AND CALCULATE RESULT
================================ */

function submitQuiz() {
    if (latestResult !== null) {
        return;
    }

    stopTimer();

    const questions = quizData[currentCategory];
    let correct = 0;

    questions.forEach(function(question, index) {
        if (userAnswers[index] === question.answer) {
            correct++;
        }
    });

    const total = questions.length;
    const percentage = Math.round(correct / total * 100);

    latestResult = {
        category: currentCategory,
        correct: correct,
        wrong: total - correct,
        total: total,
        percentage: percentage,
        points: correct * 10,
        date: new Date().toLocaleString()
    };

    history.push(latestResult);

    displayResults(latestResult);
    showPage("results");
}

/* ================================
   RESULT DISPLAY
================================ */

function displayResults(result) {
    document.getElementById("resultPercentage").textContent =
        result.percentage + "%";

    document.getElementById("correctAnswers").textContent =
        result.correct;

    document.getElementById("wrongAnswers").textContent =
        result.wrong;

    document.getElementById("resultPoints").textContent =
        result.points;

    document.getElementById("resultMessage").textContent =
        result.category + " quiz results";

    let message = "Keep practicing!";

    if (result.percentage >= 90) {
        message = "Excellent! Outstanding performance!";
    } else if (result.percentage >= 75) {
        message = "Very good! You know this subject well.";
    } else if (result.percentage >= 50) {
        message = "Good effort! Keep improving.";
    }

    document.getElementById("resultTitle").textContent = message;
}

/* ================================
   RESULT BUTTONS
================================ */

document.getElementById("retryBtn").addEventListener("click", function() {
    startQuiz(currentCategory);
});

document.getElementById("dashboardBtn").addEventListener("click", function() {
    showPage("dashboard");
});

/* ================================
   DASHBOARD STATISTICS
================================ */

function updateDashboard() {
    const totalQuizzes = history.length;

    const totalPoints = history.reduce(function(sum, item) {
        return sum + item.points;
    }, 0);

    const average = totalQuizzes
        ? Math.round(
            history.reduce(function(sum, item) {
                return sum + item.percentage;
            }, 0) / totalQuizzes
        )
        : 0;

    const best = totalQuizzes
        ? Math.max.apply(null, history.map(function(item) {
            return item.percentage;
        }))
        : 0;

    document.getElementById("totalQuizzes").textContent =
        totalQuizzes;

    document.getElementById("averageScore").textContent =
        average + "%";

    document.getElementById("bestScore").textContent =
        best + "%";

    document.getElementById("totalPoints").textContent =
        totalPoints;

    renderChart();
    renderRecentActivity();
}

/* ================================
   PERFORMANCE GRAPH
================================ */

function renderChart() {
    const chart = document.getElementById("performanceChart");
    chart.innerHTML = "";

    if (history.length === 0) {
        const message = document.createElement("p");
        message.className = "muted";
        message.textContent =
            "Complete a quiz to see your performance graph.";

        chart.appendChild(message);
        return;
    }

    const recent = history.slice(-7);

    recent.forEach(function(result, index) {
        const column = document.createElement("div");
        column.className = "bar-column";

        const score = document.createElement("small");
        score.textContent = result.percentage + "%";

        const bar = document.createElement("div");
        bar.className = "bar";
        bar.style.height = Math.max(result.percentage, 3) + "%";
        bar.title = result.category + ": " + result.percentage + "%";

        const label = document.createElement("small");
        label.textContent = result.category.slice(0, 3) +
            (index + 1);

        column.append(score, bar, label);
        chart.appendChild(column);
    });
}

/* ================================
   RECENT ACTIVITY
================================ */

function renderRecentActivity() {
    const container = document.getElementById("recentActivity");
    container.innerHTML = "";

    if (history.length === 0) {
        const message = document.createElement("p");
        message.className = "muted";
        message.textContent = "No quizzes completed yet.";
        container.appendChild(message);
        return;
    }

    history.slice(-5).reverse().forEach(function(result) {
        const row = document.createElement("p");

        row.style.padding = "12px 0";
        row.style.borderBottom = "1px solid #e2e8f0";

        row.textContent =
            result.category + " Quiz — " +
            result.percentage + "% — " + result.date;

        container.appendChild(row);
    });
}

/* ================================
   HISTORY TABLE
================================ */

function renderHistory() {
    const table = document.getElementById("historyTable");
    table.innerHTML = "";

    if (history.length === 0) {
        const row = document.createElement("tr");
        const cell = document.createElement("td");

        cell.colSpan = 5;
        cell.textContent = "No quiz history available.";

        row.appendChild(cell);
        table.appendChild(row);
        return;
    }

    history.slice().reverse().forEach(function(result) {
        const row = document.createElement("tr");

        const values = [
            result.category,
            result.correct,
            result.total,
            result.percentage + "%",
            result.percentage >= 50 ? "Passed" : "Keep Practicing"
        ];

        values.forEach(function(value, index) {
            const cell = document.createElement("td");
            cell.textContent = value;

            if (index === 4 && result.percentage >= 50) {
                cell.className = "status";
            }

            row.appendChild(cell);
        });

        table.appendChild(row);
    });
}

/* ================================
   PROFILE MANAGEMENT
================================ */

document.getElementById("profileForm")
    .addEventListener("submit", function(event) {
        event.preventDefault();

        const name =
            document.getElementById("profileName").value.trim();

        if (!name) {
            alert("Please enter your name.");
            return;
        }

        username = name;

        document.getElementById("welcomeTitle").textContent =
            "Welcome, " + username + "!";

        document.getElementById("headerUsername").textContent =
            username;

        alert("Profile updated successfully!");
    });

/* ================================
   INITIALIZATION
================================ */

renderCategories();

</script>
