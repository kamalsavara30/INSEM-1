# Online Quiz Application
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Online Quiz Application</title>
<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: Arial, sans-serif;
}
body {
    background: #f1f5f9;
    color: #1e293b;
}
button, input, select {
    font: inherit;
}
button {
    cursor: pointer;
    border: none;
    border-radius: 8px;
    padding: 11px 18px;
}
.primary-btn {
    background: #4f46e5;
    color: white;
}
.primary-btn:hover {
    background: #3730a3;
}
.hidden {
    display: none !important;
}
/* LOGIN PAGE */
.login-page {
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 20px;
    background: linear-gradient(135deg, #4338ca, #06b6d4);
}
.login-box {
    background: white;
    width: 100%;
    max-width: 420px;
    padding: 35px;
    border-radius: 18px;
    box-shadow: 0 15px 40px #0002;
}
.login-box h1 {
    text-align: center;
    color: #4f46e5;
    margin-bottom: 10px;
}

.login-box p {
    text-align: center;
    color: #64748b;
    margin-bottom: 25px;
}

.form-group {
    margin-bottom: 18px;
}

.form-group label {
    display: block;
    margin-bottom: 8px;
    font-weight: bold;
}

.form-group input {
    width: 100%;
    padding: 12px;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
}

.login-box button {
    width: 100%;
}

.demo-text {
    margin-top: 15px;
    font-size: 13px;
}

/* MAIN APPLICATION */

.app {
    min-height: 100vh;
}

.sidebar {
    width: 240px;
    background: #111827;
    color: white;
    position: fixed;
    top: 0;
    bottom: 0;
    left: 0;
    padding: 25px 16px;
}

.logo {
    font-size: 23px;
    font-weight: bold;
    padding: 8px;
    margin-bottom: 30px;
}

.logo span {
    color: #818cf8;
}

.sidebar button {
    display: block;
    width: 100%;
    text-align: left;
    background: transparent;
    color: #cbd5e1;
    margin-bottom: 9px;
}

.sidebar button:hover,
.sidebar button.active {
    background: #3730a3;
    color: white;
}

.sidebar .logout {
    margin-top: 35px;
    color: #fca5a5;
}

.main-content {
    margin-left: 240px;
    padding: 25px;
}

.topbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 15px;
    margin-bottom: 30px;
    flex-wrap: wrap;
}

.topbar h2 {
    margin-bottom: 5px;
}

.muted {
    color: #64748b;
}

.profile {
    background: white;
    border-radius: 10px;
    padding: 12px 18px;
}

/* DASHBOARD CARDS */

.stats-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 18px;
    margin-bottom: 25px;
}

.stat-card {
    background: white;
    padding: 22px;
    border-radius: 13px;
    box-shadow: 0 3px 12px #00000008;
}

.stat-card .icon {
    font-size: 27px;
    margin-bottom: 12px;
}

.stat-card h3 {
    font-size: 27px;
    margin: 8px 0;
}

.stat-card p {
    color: #64748b;
    font-size: 14px;
}

/* DASHBOARD SECTIONS */

.content-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 20px;
    margin-bottom: 25px;
}

.panel {
    background: white;
    padding: 23px;
    border-radius: 13px;
    margin-bottom: 22px;
}

.panel h3 {
    margin-bottom: 18px;
}

.chart {
    height: 210px;
    display: flex;
    align-items: end;
    justify-content: space-around;
    gap: 14px;
    border-bottom: 1px solid #e2e8f0;
    padding: 10px 0 0;
}

.bar-column {
    flex: 1;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: end;
    align-items: center;
    gap: 8px;
}

.bar {
    width: min(40px, 80%);
    background: #6366f1;
    border-radius: 7px 7px 0 0;
    min-height: 5px;
    transition: height .3s;
}

.bar-column small {
    color: #64748b;
    margin-bottom: 5px;
}

.progress-row {
    margin: 18px 0;
}

.progress-label {
    display: flex;
    justify-content: space-between;
    margin-bottom: 8px;
    font-size: 14px;
}

.progress-track {
    height: 9px;
    background: #e2e8f0;
    border-radius: 10px;
    overflow: hidden;
}

.progress-fill {
    height: 100%;
    background: #6366f1;
    border-radius: 10px;
}

/* QUIZ CATEGORIES */

.category-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
}

.category-card {
    background: white;
    padding: 23px;
    border-radius: 13px;
    border: 1px solid #e2e8f0;
}

.category-card .category-icon {
    font-size: 34px;
    margin-bottom: 15px;
}

.category-card h3 {
    margin-bottom: 10px;
}

.category-card p {
    color: #64748b;
    font-size: 14px;
    line-height: 1.6;
    margin-bottom: 18px;
}

/* QUIZ SCREEN */

.quiz-box {
    background: white;
    padding: 30px;
    border-radius: 14px;
    max-width: 850px;
    margin: auto;
}

.quiz-header {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 25px;
}

.timer {
    background: #fee2e2;
    color: #b91c1c;
    padding: 10px 15px;
    border-radius: 8px;
    font-weight: bold;
}

.question-number {
    color: #4f46e5;
    font-weight: bold;
    margin-bottom: 15px;
}

.question-text {
    font-size: 22px;
    line-height: 1.5;
    margin-bottom: 25px;
}

.options {
    display: grid;
    gap: 12px;
}

.option {
    text-align: left;
    width: 100%;
    padding: 15px;
    border: 1px solid #cbd5e1;
    background: white;
    border-radius: 9px;
}

.option:hover {
    background: #eef2ff;
    border-color: #6366f1;
}

.option.selected {
    background: #e0e7ff;
    border-color: #4f46e5;
}

.quiz-actions {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin-top: 30px;
}

.secondary-btn {
    background: #e2e8f0;
    color: #1e293b;
}

/* RESULTS */

.result-box {
    max-width: 750px;
    margin: auto;
    background: white;
    padding: 35px;
    border-radius: 15px;
    text-align: center;
}

.score-circle {
    width: 150px;
    height: 150px;
    border: 10px solid #818cf8;
    border-radius: 50%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    margin: 25px auto;
}

.score-circle strong {
    font-size: 34px;
    color: #4338ca;
}

.result-details {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    margin: 25px 0;
}

.result-details div {
    background: #f1f5f9;
    padding: 18px 8px;
    border-radius: 10px;
}

.result-details strong {
    display: block;
    font-size: 23px;
    margin-bottom: 7px;
}

/* HISTORY TABLE */

.table-wrapper {
    overflow-x: auto;
}

table {
    width: 100%;
    border-collapse: collapse;
}

th, td {
    text-align: left;
    padding: 15px 12px;
    border-bottom: 1px solid #e2e8f0;
    white-space: nowrap;
}

th {
    background: #f8fafc;
}

.status {
    color: #047857;
    font-weight: bold;
}

/* PROFILE */

.profile-form {
    max-width: 600px;
}

.profile-form input {
    width: 100%;
    padding: 12px;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
}

/* RESPONSIVE DESIGN */

@media (max-width: 1050px) {
    .stats-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .category-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .content-grid {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 700px) {
    .sidebar {
        position: static;
        width: 100%;
        padding: 15px;
    }

    .logo {
        margin-bottom: 12px;
    }

    .sidebar button {
        display: inline-block;
        width: auto;
        margin: 3px;
        padding: 9px;
        font-size: 13px;
    }

    .sidebar .logout {
        margin-top: 3px;
    }

    .main-content {
        margin-left: 0;
        padding: 16px;
    }

    .stats-grid,
    .category-grid {
        grid-template-columns: 1fr;
    }

    .quiz-box,
    .result-box {
        padding: 20px;
    }

    .question-text {
        font-size: 19px;
    }

    .result-details {
        grid-template-columns: 1fr;
    }
}
</style>
</head>

<body>

<!-- LOGIN PAGE -->

<section id="loginPage" class="login-page">
    <div class="login-box">
        <h1>QuizMaster</h1>
        <p>Learn, practice, and test your knowledge.</p>

        <form id="loginForm">
            <div class="form-group">
                <label for="username">Username</label>
                <input
                    type="text"
                    id="username"
                    placeholder="Enter your username"
                    required
                >
            </div>

            <div class="form-group">
                <label for="password">Password</label>
                <input
                    type="password"
                    id="password"
                    placeholder="Enter any password"
                    required
                >
            </div>

            <button class="primary-btn" type="submit">
                Login to Dashboard
            </button>
        </form>

        <p class="demo-text">
            Demo project: enter any username and password.
        </p>
    </div>
</section>

<!-- APPLICATION -->

<div id="app" class="app hidden">

    <aside class="sidebar">
        <div class="logo">Quiz<span>Master</span></div>

        <button class="active" data-page="dashboard">
            🏠 Dashboard
        </button>

        <button data-page="categories">
            📚 Quiz Categories
        </button>

        <button data-page="history">
            📊 Quiz History
        </button>

        <button data-page="profile">
            👤 My Profile
        </button>

        <button class="logout" id="logoutBtn">
            🚪 Logout
        </button>
    </aside>

    <main class="main-content">

        <header class="topbar">
            <div>
                <h2 id="welcomeTitle">Welcome!</h2>
                <p class="muted">Your learning dashboard</p>
            </div>

            <div class="profile">
                👤 <span id="headerUsername">Student</span>
            </div>
        </header>

        <!-- DASHBOARD -->

        <section id="dashboardPage">

            <div class="stats-grid">

                <div class="stat-card">
                    <div class="icon">📝</div>
                    <p>Total Quizzes</p>
                    <h3 id="totalQuizzes">0</h3>
                    <p>Quizzes completed</p>
                </div>

                <div class="stat-card">
                    <div class="icon">🎯</div>
                    <p>Average Score</p>
                    <h3 id="averageScore">0%</h3>
                    <p>Your overall performance</p>
                </div>

                <div class="stat-card">
                    <div class="icon">🏆</div>
                    <p>Best Score</p>
                    <h3 id="bestScore">0%</h3>
                    <p>Your highest result</p>
                </div>

                <div class="stat-card">
                    <div class="icon">⭐</div>
                    <p>Total Points</p>
                    <h3 id="totalPoints">0</h3>
                    <p>Points earned</p>
                </div>

            </div>

            <div class="content-grid">

                <div class="panel">
                    <h3>📈 Quiz Performance Graph</h3>
                    <p class="muted">
                        Your latest quiz scores
                    </p>

                    <div id="performanceChart" class="chart">
                        <p class="muted">Complete a quiz to see your graph.</p>
                    </div>
                </div>

                <div class="panel">
                    <h3>📚 Available Subjects</h3>

                    <div class="progress-row">
                        <div class="progress-label">
                            <span>HTML</span><span>80%</span>
                        </div>
                        <div class="progress-track">
                            <div class="progress-fill" style="width:80%"></div>
                        </div>
                    </div>

                    <div class="progress-row">
                        <div class="progress-label">
                            <span>CSS</span><span>70%</span>
                        </div>
                        <div class="progress-track">
                            <div class="progress-fill" style="width:70%"></div>
                        </div>
                    </div>

                    <div class="progress-row">
                        <div class="progress-label">
                            <span>JavaScript</span><span>65%</span>
                        </div>
                        <div class="progress-track">
