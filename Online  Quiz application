                        </div>
                    </div>

                    <div class="progress-row">
                        <div class="progress-label">
                            <span>Java</span><span>60%</span>
                        </div>
                        <div class="progress-track">
                            <div class="progress-fill" style="width:60%"></div>
                        </div>
                    </div>
                </div>

            </div>

            <div class="panel">
                <h3>🚀 Start a New Quiz</h3>
                <p class="muted">
                    Choose a subject and test your knowledge.
                </p>
                <br>
                <button class="primary-btn" data-page="categories">
                    Explore Quiz Categories
                </button>
            </div>

            <div class="panel">
                <h3>🕒 Recent Quiz Activity</h3>
                <div id="recentActivity">
                    <p class="muted">
                        No quizzes completed yet.
                    </p>
                </div>
            </div>

        </section>

        <!-- QUIZ CATEGORIES -->

        <section id="categoriesPage" class="hidden">
            <div class="panel">
                <h2>Quiz Categories</h2>
                <p class="muted">
                    Select a subject to start your quiz.
                </p>
            </div>

            <div class="category-grid" id="categoryGrid"></div>
        </section>

        <!-- ACTIVE QUIZ -->

        <section id="quizPage" class="hidden">

            <div class="quiz-box">

                <div class="quiz-header">
                    <div>
                        <h2 id="quizTitle">HTML Quiz</h2>
                        <p class="muted">Choose the correct answer.</p>
                    </div>

                    <div class="timer">
                        ⏱ <span id="timer">05:00</span>
                    </div>
                </div>

                <div class="progress-track">
                    <div
                        id="quizProgress"
                        class="progress-fill"
                        style="width:0%"
                    ></div>
                </div>

                <br>

                <p class="question-number" id="questionNumber"></p>

                <h3 class="question-text" id="questionText"></h3>

                <div class="options" id="optionsContainer"></div>

                <div class="quiz-actions">
                    <button
                        class="secondary-btn"
                        id="previousBtn"
                    >
                        Previous
                    </button>

                    <button
                        class="primary-btn"
                        id="nextBtn"
                    >
                        Next
                    </button>

                    <button
                        class="primary-btn hidden"
                        id="submitBtn"
                    >
                        Submit Quiz
                    </button>
                </div>

            </div>

        </section>

        <!-- RESULTS -->

        <section id="resultsPage" class="hidden">
            <div class="result-box">

                <h2>🎉 Quiz Completed!</h2>
                <p class="muted" id="resultMessage">
                    Here is your result.
                </p>

                <div class="score-circle">
                    <strong id="resultPercentage">0%</strong>
                    <span>Score</span>
                </div>

                <h3 id="resultTitle">Good effort!</h3>

                <div class="result-details">
                    <div>
                        <strong id="correctAnswers">0</strong>
                        <span>Correct</span>
                    </div>

                    <div>
                        <strong id="wrongAnswers">0</strong>
                        <span>Incorrect</span>
                    </div>

                    <div>
                        <strong id="resultPoints">0</strong>
                        <span>Points</span>
                    </div>
                </div>

                <button
                    class="primary-btn"
                    id="retryBtn"
                >
                    Try Again
                </button>

                <button
                    class="secondary-btn"
                    id="dashboardBtn"
                >
                    Dashboard
                </button>

            </div>
        </section>

        <!-- HISTORY -->

        <section id="historyPage" class="hidden">
            <div class="panel">
                <h2>Quiz History</h2>
                <p class="muted">
                    Review your completed quizzes.
                </p>
                <br>

                <div class="table-wrapper">
                    <table>
                        <thead>
                            <tr>
                                <th>Subject</th>
                                <th>Correct</th>
                                <th>Total</th>
                                <th>Score</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody id="historyTable"></tbody>
                    </table>
                </div>
            </div>
        </section>

        <!-- PROFILE -->

        <section id="profilePage" class="hidden">
            <div class="panel profile-form">
                <h2>My Profile</h2>
                <p class="muted">
                    Update your student information.
                </p>
                <br>

                <form id="profileForm">
                    <div class="form-group">
                        <label for="profileName">Full Name</label>
                        <input id="profileName" required>
                    </div>

                    <div class="form-group">
                        <label for="profileEmail">Email Address</label>
                        <input
                            id="profileEmail"
                            type="email"
                            placeholder="student@example.com"
                        >
                    </div>

                    <div class="form-group">
                        <label for="profileCourse">Course</label>
                        <input
                            id="profileCourse"
                            placeholder="B.Tech / BCA / MCA"
                        >
                    </div>

                    <button class="primary-btn" type="submit">
                        Save Profile
                    </button>
                </form>
            </div>
        </section>

    </main>
</div>

